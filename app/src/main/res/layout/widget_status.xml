<?xml version="1.0" encoding="utf-8"?>
<!-- StatusWidget: header, clock and power, date. StatusWidget hides header and date when the widget is short. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="TREKUI • CHRONOMETER"
        android:textColor="#FF9C00"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:maxLines="1"
            android:textColor="#E0D8FF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="PWR --%"
            android:textColor="#FF9C00"
            android:textSize="15sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:format12Hour="EEEE, MMM d yyyy"
        android:format24Hour="EEEE, MMM d yyyy"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#DD88AA"
        android:textSize="13sp" />
</LinearLayout>
