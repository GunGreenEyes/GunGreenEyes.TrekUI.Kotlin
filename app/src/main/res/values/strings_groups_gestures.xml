    <!-- LOCK SCREEN: Google Play prominent disclosure (shown before the user is sent to Accessibility settings).
         Keep this text in sync with docs/PLAY_STORE.md › Accessibility API disclosure. -->
    <string name="lock_disclosure_title">LOCK SCREEN • ACCESSIBILITY</string>
    <string name="lock_disclosure_body">TrekUI Launcher uses Android\'s Accessibility Service API for one purpose only: to lock your screen when YOU run the LOCK SCREEN function from a tile, element or gesture you set up.\n\nThe service cannot see or read what is on your screen, does not observe what you type or tap, and does not collect, store or share any data. It performs no action other than locking the screen when you ask.\n\nIf you agree, Android\'s Accessibility settings open: choose \"TrekUI Screen Lock\" and turn it on. You can turn it off there at any time; LOCK SCREEN then stops working and nothing else changes.</string>
    <string name="lock_disclosure_accept">AGREE • OPEN SETTINGS</string>
    <string name="lock_disclosure_decline">NO THANKS</string>
    <string name="lock_service_label">TrekUI Screen Lock</string>
    <string name="lock_service_description">Lets TrekUI Launcher lock the screen when you use its LOCK SCREEN function (a tile, element or gesture you assigned). It cannot read screen content, does not observe your actions, and collects no data.</string>
    <string name="lock_service_summary">Locks the screen from a launcher tile or gesture</string>
    <string name="toast_lock_needs_p">LOCK SCREEN NEEDS ANDROID 9 OR NEWER</string>
    <string name="toast_lock_failed">COULD NOT LOCK • CHECK ACCESSIBILITY SETTINGS</string>
