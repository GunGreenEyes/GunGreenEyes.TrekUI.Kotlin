<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tile icon for CLOAK (night mode): a TrekUI elbow fading into a crescent of dots.
     Original design for this project. Monochrome: the system tints it for the tile state. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- crescent -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.5,3A9,9 0,1 0,21 17.2A7,7 0,0 1,14.5 3Z" />
    <!-- fading trail of dots: the ship disappearing -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.75"
        android:pathData="M19,4.5m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M21.5,9m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0" />
</vector>
