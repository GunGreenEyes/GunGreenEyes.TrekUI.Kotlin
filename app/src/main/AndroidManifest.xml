<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Weather (Open-Meteo, HTTPS only) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Govee LAN discovery (UDP multicast on the local Wi-Fi) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional, asked at runtime only if you choose "use device location" for weather -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional, asked at runtime only when you enable the calendar panel -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Apply TrekUI wallpapers from settings -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Swipe down on home to open the notification shade -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" from the app drawer long-press menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- TrekUI shade: brightness slider and auto-rotate tile (user grants "Modify system settings") -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- TrekUI shade: Bluetooth on/off indicator on Android 11 and older -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- TrekUI dialer (all optional, asked when first used): place calls, list contacts and recent calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Audio panel source buttons: link to media apps' playback services (Audible, YT Music, VLC…) -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <package android:name="com.audible.application" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="org.videolan.vlc" />
        <!-- CONFIG > APP THEMING: "OPEN <app>" / Good Lock buttons check these are installed -->
        <package android:name="com.samsung.android.goodlock" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.android.chrome" />
        <package android:name="com.microsoft.office.outlook" />
        <!-- LCA-T22: third-party icon packs (ADW / Nova / Go / Apex / Atom / Fede formats), see IconPacks -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.dlto.atom.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/TrekUiTheme"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_name"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing" />

        <!-- ADD WIDGET PANEL: pick, bind and configure another app's widget (translucent, over home) -->
        <activity
            android:name=".WidgetPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale" />

        <!-- Purchase / unlock screen (com.gungreeneyes.trekui.licensing) -->
        <activity
            android:name=".licensing.PurchaseActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Only bound by Android if YOU grant "notification access" for track titles/art.
             It does no work of its own; it just authorises reading media sessions. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/media_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Home-screen widgets for use in OTHER launchers -->
        <receiver
            android:name=".StatusWidget"
            android:exported="true"
            android:label="@string/widget_status_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_widget" />
        </receiver>
        <receiver
            android:name=".QuickWidget"
            android:exported="true"
            android:label="@string/widget_quick_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget" />
        </receiver>
        <!-- renumbers hosted widget panels after a backup restore (system broadcast to the host app) -->
        <receiver android:name=".WidgetRestoreReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>
        <!-- ends CLOAK mode when its timer runs out -->
        <receiver android:name=".Cloak$Receiver" android:exported="false" />
        <!-- stands RED ALERT down when its timeout passes (backup for the in-process timer) -->
        <receiver android:name=".RedAlert$Receiver" android:exported="false" />
        <!-- Quick Settings tiles: CLOAK and RED ALERT -->
        <service
            android:name=".CloakTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_cloak"
            android:label="@string/qs_cloak"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".RedAlertTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_red_alert"
            android:label="@string/qs_red_alert"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- LCA-T20: optional LOCK SCREEN service. Off until the user accepts the in-app disclosure
             (LockScreen.showDisclosure) and turns it on in Accessibility settings. Reads no events and
             no window content; only performs GLOBAL_ACTION_LOCK_SCREEN (Android 9+). No Device Admin. -->
        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
